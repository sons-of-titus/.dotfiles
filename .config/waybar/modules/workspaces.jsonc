{
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "一",
            "2": "二",
            "3": "三",
            "4": "四",
            "5": "五",
            "6": "六",
            "7": "七",
            "8": "八",
            "9": "九",
            "10": "十",
            "default": "",
            "urgent": "!"
        },
        "on-click": "workspace",
        "on-scroll-up": "workspace -1",
        "on-scroll-down": "workspace +1"
    }
}